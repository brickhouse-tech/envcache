# ~/.envcache.secrets — Define secrets to resolve from 1Password
#
# Format: VAR_NAME|op://vault/item/field
# Optional post-processor: VAR_NAME|op://vault/item/field|strip_whitespace
#
# Lines starting with # are comments. Blank lines are ignored.

# GitHub tokens
GH_TOKEN|op://MyVault/GitHub PAT/password

# API keys
MY_API_KEY|op://MyVault/Service API Key/password
MY_API_SECRET|op://MyVault/Service API Key/secret

# Example with whitespace stripping (some 1Password fields have trailing newlines)
TELEGRAM_TOKEN|op://MyVault/Telegram Bot/password|strip_whitespace
